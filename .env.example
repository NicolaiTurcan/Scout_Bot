ANTHROPIC_API_KEY=sk-ant-your-key-here
ANTHROPIC_MODEL=claude-haiku-5-5

# --- Observability (OpenTelemetry via TraceVerde) ---
OTEL_SERVICE_NAME=scoutbot
# Local Jaeger from docker-compose.yml (use 127.0.0.1, not localhost: Windows may try IPv6 first).
# Set it to an empty value to print spans to the console instead.
OTEL_EXPORTER_OTLP_ENDPOINT=http://127.0.0.1:4318
# Keep prompts/completions out of spans unless you explicitly need them.
GENAI_ENABLE_CONTENT_CAPTURE=false
# Trace viewer used for links in `resume_demo.py history` (default: local Jaeger UI).
TRACE_UI_URL=http://127.0.0.1:16686
